# Build artifacts
*.exe
*.obj
*.tlog
*vcxprog*
*.so
Server/build/*

# SDK / FHETCH-transport flow (scripts/build_task.sh + harness/run_submission.py)
/build/
NID_Mirai_*_workload*/
measurements/

# Python
__pycache__
__pycache__/
**/*.pyc
**/__pycache__

# macOS
.DS_Store

# Profiling and logs
*.profraw
*_output.txt
trace*.log

# Run archives (generated by workflow execution)
runs/

# NFS lock files (stale locks from network filesystem)
.nfs*

# EXCEPTION: Allow build logs in runs/ archive directory
!runs/**/build.log

# Backup files
*.bak
*.bak[0-9]
*.backup

# Generated directories
decrypt_tool/
global_key_cache/
NID_*_workload/

# Large data files (regenerate from scripts)
*.npy
Mirai_features_*.bin
mirai_small_features.bin

# Pre-extracted batch files (auto-generated at runtime, not committed)
# These are 13 MB each and regenerated from PCAP as needed
assets/datasets/*_batch_*.bin

# Temporary files
*.patch
*_attempt.txt
*_failed_output.txt

# Local archive directories (keep history locally, not in repo)
LOCAL_ARCHIVE_*/

# JSON files (from origin/main)
*.json
!profiles.json

# Ignore large ciphertext binaries
*.bin
# But keep model and normalization binaries for all datasets
!Datasets/**/*_model.bin
!Datasets/**/*_norm.bin
feature_ciphertext_*.bin
relinearization_key.bin
secret_key.bin
score_ciphertext_fhe.bin
cryptocontext.bin

# ============================================================
# CRYPTOGRAPHIC MATERIAL - RECURSIVE PATTERNS (CRITICAL!)
# ============================================================
# These patterns use **/ to match in ANY directory, not just root

# Specific key files (recursive - matches in any directory)
**/secret_key*.bin
**/public_key*.bin
**/cryptocontext*.bin
**/relinearization_key*.bin

# Generic crypto patterns
**/*.key
**/*.pem
**/*.crt
**/*_key.bin

# Encrypted ciphertexts (large files)
**/feature_ciphertext_*.bin
**/score_ciphertext*.bin
**/*ciphertext*.bin

# ============================================================
# Legacy Claire Directories - EXPLICIT BLOCKING
# ============================================================
# These contain old crypto keys - NEVER commit
Claire_Params_Keys/
Claire_Params_Keys_FRESH/
Mirai_Workload_Inputs_CLAIRE_ORIGINAL/
*CLAIRE*/
*Claire*/

# ============================================================
# Generated Workload Directories (contain crypto material)
# ============================================================
*_Workload/
*_Workload_Inputs/
workloads/

# ============================================================
# Test/Debug Key Directories - EXPLICIT BLOCKING
# ============================================================
# Block any directory with "key" or "Key" in the name
*Key*/
*Keys*/
*key*/
*keys*/
Final_Test_Keys/
.concurrent/

# Python virtualenv
.venv/

# local replay scratch (server/backend unpack dirs)
nbcc_fhetch_replay_source_*/

# stray run plots (report writes to runs/<id>/plots|graphs instead)
*_results.png
